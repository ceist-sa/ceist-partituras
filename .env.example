# Notion internal integration token (https://www.notion.so/profile/integrations). The integration needs
# access to the "Programas" and "Repertório" databases.
# Leave empty in development to use the sample repertoire in src/lib/server/sample.json instead of Notion.
NOTION_TOKEN=
# "Programas" database (name, season, dates)
NOTION_PROGRAMS_DB=41a419a3db6c8067a683c41da26b8615
# "Repertório" database (name, composer, link to the sheet music, programs)
NOTION_REPERTOIRE_DB=323419a3db6c800e8f09f7e387a8a894

# Optional GitHub token (read access to public repositories is enough). Without it the site still works:
# it asks GitHub for the list of files a few times an hour, well within the limit for anonymous requests.
GITHUB_TOKEN=
